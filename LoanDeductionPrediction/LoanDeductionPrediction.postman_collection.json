                "Loan",
                "borrower",
                "{{borrowerId}}"
              ]
            }
          }
        },
        {
          "name": "Get Officer Loans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
