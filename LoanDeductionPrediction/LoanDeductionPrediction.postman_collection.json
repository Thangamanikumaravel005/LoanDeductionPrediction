                "officer",
                "{{officerId}}"
              ]
            }
          }
        },
        {
          "name": "Create Loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrowerId\": 1,\n  \"loanOfficerId\": 1,\n  \"principalAmount\": 100000,\n  \"annualInterestRate\": 10,\n  \"tenureMonths\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Loan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Loan"
              ]
            }
          }
        },
        {
          "name": "Update Loan Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "\"ACTIVE\""
            },
            "url": {
              "raw": "{{baseUrl}}/api/Loan/{{loanId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Loan",
                "{{loanId}}",
                "status"
              ]
            }
          }
        }
      ]
    },
