      "item": [
        {
          "name": "Get All Loans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Loan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Loan"
              ]
            }
          }
        },
        {
          "name": "Get Loan By ID",
